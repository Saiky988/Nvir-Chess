# Discord bot token (Developer Portal -> Bot -> Reset Token). Never commit the real value.
DISCORD_TOKEN=

# SQLite file, relative to the project root or absolute.
DATABASE_PATH=data/chess.db

# Prefix for owner-only text commands (mentioning the bot also works).
BOT_PREFIX=!

# Default board theme, 1-5 (assets/boards/board_plain_0N.png).
BOARD_THEME=1

# Log level: CRITICAL, ERROR, WARNING, INFO, DEBUG.
LOG_LEVEL=INFO

# Web API / Hosting configuration (shared hosting, Pterodactyl, Render, VPS)
HOST=0.0.0.0
PORT=8000

# Set to true to run both bot and FastAPI health server together via python main.py
ENABLE_API=false
